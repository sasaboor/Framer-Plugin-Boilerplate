# ==============================================
# FRAMER PLUGIN ENVIRONMENT VARIABLES
# ==============================================
# Copy this file to .env and fill in your actual values
# NEVER commit your .env file to version control!

# ==============================================
# SUPABASE CONFIGURATION
# ==============================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

# Your Supabase project URL
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase anonymous key (safe to expose in client-side code)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ==============================================
# POLAR.SH CONFIGURATION
# ==============================================
# Get these from: https://polar.sh/dashboard

# Polar.sh access token (keep this secret!)
VITE_POLAR_ACCESS_TOKEN=polar_oat_your_access_token_here

# Your Polar.sh organization ID
VITE_POLAR_ORG_ID=your_org_id_here

# Your Polar.sh product/subscription ID
VITE_POLAR_PRODUCT_ID=your_product_id_here

# ==============================================
# NOTES
# ==============================================
# 1. Service Role Key (SUPABASE_SERVICE_ROLE_KEY) should ONLY be stored in:
#    - Supabase Edge Function secrets
#    - Server-side environment variables
#    NEVER store it in .env or client-side code!
#
# 2. After filling in values, rename this file to .env
#
# 3. Verify .env is listed in .gitignore before committing
#
# 4. For production deployments, use environment variables in your hosting platform
